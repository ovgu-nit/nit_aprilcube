<?xml version="1.0" ?>
<sdf version="1.4">
  <model name="aprilcube">
    <static>0</static>
    <link name="link">

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>8.33e-05</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>8.33e-05</iyy>
          <iyz>0.0</iyz>
          <izz>8.33e-05</izz>
        </inertia>
      </inertial>

      <collision name="colision">
        <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
        <surface>
          <friction>
            <ode>
              <mu>30.0</mu>
              <mu2>30.0</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
            <kp>1000000.0</kp>   <!-- 10x stiffer -->
<kd>10.0</kd>         <!-- a bit more damping -->
<min_depth>0.0001</min_depth>  <!-- tighter contact threshold -->
<max_vel>0.01</max_vel>        <!-- slower penetration response -->
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual1">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://aprilcube/meshes/aprilcube.dae</uri>
	          <scale> .025 .025 .025 </scale>
          </mesh>
        </geometry>
      </visual>
<velocity_decay>
  <linear>0.01</linear>
  <angular>0.01</angular>
</velocity_decay>
      <self_collide>0</self_collide>
      <kinematic>0</kinematic>
      <gravity>1</gravity>
    </link>
  </model>
</sdf>
